# Kunci enkripsi cookie sesi pemain — WAJIB di production, minimal 32 karakter acak.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# OAuth Client ID Google (tipe "Web application").
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID.
# Tambahkan origin situs (mis. http://localhost:3000 dan domain production) ke
# "Authorized JavaScript origins". Kosongkan untuk menonaktifkan login Google
# (semua pemain tetap bisa main dengan profil acak).
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# Database leaderboard (Upstash Redis). Di Vercel diisi otomatis oleh integrasi
# Upstash dari Marketplace (nama KV_REST_API_URL/KV_REST_API_TOKEN juga didukung).
# Kosongkan saat development lokal → data disimpan di folder .data/kv.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
